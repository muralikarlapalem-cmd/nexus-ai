# ─────────────────────────────────────────────────────────────
#  NEXUS AI  ·  Environment Variables
#  Copy this to .env and fill in your values
#  NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_NAME=NEXUS AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexusai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme_postgres_password
# Async DSN (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://nexus:changeme_postgres_password@postgres:5432/nexusai

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:changeme_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme_redis_password@redis:6379/2

# ── Keycloak (OIDC) ──────────────────────────────────────────
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changeme_keycloak_admin_password
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=nexus
KEYCLOAK_CLIENT_ID=nexus-backend
KEYCLOAK_CLIENT_SECRET=REPLACE_ME_WITH_KC_CLIENT_SECRET
# JWKS endpoint — used to verify Keycloak JWTs
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/nexus/protocol/openid-connect/certs

# ── JWT (local fallback — used only when Keycloak is unavailable) ─
JWT_SECRET_KEY=REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET_32_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM (Phase 3 onwards) ─────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME_WITH_YOUR_OPENAI_KEY
LLM_MODEL=gpt-4o                       # or gpt-4o-mini for lower cost
LLM_TEMPERATURE=0.0

# ── Web search (Diagnosis Agent fallback) ─────────────────────
# Used only when the knowledge base has no good match. Leave empty to disable.
# Get a key at https://tavily.com
TAVILY_API_KEY=

# ── LangSmith (Phase 5) ───────────────────────────────────────
LANGSMITH_API_KEY=REPLACE_ME
LANGSMITH_PROJECT=nexus-ai
LANGCHAIN_TRACING_V2=true

# ── Embeddings (Phase 2) ─────────────────────────────────────
# Options: ollama (free local) | openai (requires key above)
EMBEDDING_PROVIDER=openai              # switch to 'ollama' for free local embeddings
VECTOR_DIM=1536                        # 1536 for openai, 768 for ollama/nomic

# ── Qdrant (Phase 2) ─────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=nexus_knowledge

# ── Security ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=60
# PII redaction (Presidio): names, emails, phone/card/PAN/Aadhaar/SSN/IBAN numbers are
# removed from tickets, notes, AI queries and knowledge-base documents. On by default.
# PII_REDACTION_ENABLED=true
# PII_ENTITIES=["PERSON","EMAIL_ADDRESS","PHONE_NUMBER","CREDIT_CARD","IBAN_CODE","US_SSN","IN_PAN","IN_AADHAAR"]

# ── Observability (Prometheus, Grafana, Jaeger) ──────────────
# Grafana admin password (http://localhost:3000). The dashboard is viewable without signing in.
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_grafana_password
# OpenTelemetry traces go to Jaeger by default (set in docker-compose). Uncomment to turn off:
# OTEL_ZIPKIN_ENDPOINT=

# ── Integrations (ServiceNow and other ticketing systems) ────
# Links in notes NEXUS posts back to ServiceNow point here
PUBLIC_APP_URL=http://localhost:5173
# Credentials for connections. A connection stores only the variable NAME;
# names must start with INTEGRATION_. Restart api + celery-worker after changes.
# Mock ServiceNow (docker service "servicenow-mock"): any password you like
INTEGRATION_SERVICENOW_MOCK_PASSWORD=REPLACE_ME_mock_password
INTEGRATION_SERVICENOW_MOCK_WEBHOOK_SECRET=REPLACE_ME_long_random_string
# Real ServiceNow (developer instance or production), when you connect one.
# OAuth (recommended, and required where API password logins are off):
# INTEGRATION_SERVICENOW_CLIENT_SECRET=
# Basic auth / OAuth password grant:
# INTEGRATION_SERVICENOW_PASSWORD=
# Optional push mode for the mock, after setup-mock (see INTEGRATIONS.md):
# MOCK_SN_WEBHOOK_URL=http://api:8000/api/v1/integrations/<connection-id>/webhook
